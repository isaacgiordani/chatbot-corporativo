# Nome da tabela DynamoDB configurada para as três Lambdas.
CONNECTIONS_TABLE=valcann-dev-websocket-connections

# Tabela de mensagens: partition key conversationId e sort key messageKey.
MESSAGES_TABLE=valcann-dev-messages

# Tempo de retenção de uma conexão em horas.
CONNECTIONS_TTL_HOURS=24

# Resposta temporária do processador, antes da integração com Bedrock.
FIXED_RESPONSE=Sua mensagem foi recebida e o código será alterado depois.

# Preencha apenas quando um domínio customizado exigir outro endpoint de callback.
WEBSOCKET_CALLBACK_ENDPOINT=

# Configuração da Lambda authorizer do Cognito.
COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
COGNITO_USER_POOL_CLIENT_ID=exampleclientid
AUTH_TOKEN_QUERY_PARAM=token
