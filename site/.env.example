# Identidade visual
VITE_CLIENT_NAME=Assistente

# Amazon Cognito (use um App Client público, sem client secret)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=

# WebSocket (copie o output websocket_api_url do Terraform após o deploy)
VITE_WEBSOCKET_URL=wss://api-id.execute-api.us-east-1.amazonaws.com/dev
VITE_WEBSOCKET_ACTION=sendMessage
# Nome do parâmetro da URL; o valor é o access token obtido da sessão Cognito após o login
VITE_WEBSOCKET_TOKEN_QUERY_PARAM=token

# Ative somente para demonstrações locais, sem autenticação real
VITE_ENABLE_DEMO_MODE=false
